# HCS Discovery Studio configuration.
# Copy to .env for local overrides. NEVER commit a real .env file.
# All values below are placeholders.

# --- Core ---------------------------------------------------------------
# Where the local SQLite database, run artifacts and caches live.
HCS_DATA_DIR=./data
# "local" refuses remote model providers and remote data connectors.
HCS_NETWORK_POLICY=local
# Bind address for `hcs-discovery serve` (loopback only by default).
HCS_HOST=127.0.0.1
HCS_PORT=8787
# Threads used by CPU scientific work. Empty = let the engine decide.
HCS_CPU_THREADS=
# Maximum compound rows accepted in a single import.
HCS_MAX_IMPORT_ROWS=50000
# Maximum upload size in megabytes.
HCS_MAX_UPLOAD_MB=64

# --- Local OpenAI-compatible LLM provider -------------------------------
# Example: llama.cpp server, LM Studio or any compatible endpoint.
HCS_LLM_BASE_URL=http://127.0.0.1:1234/v1
HCS_LLM_MODEL=
# Secret references only: put the key in the OS environment, not in a file.
HCS_LLM_API_KEY=

# --- Optional remote provider (disabled unless you opt in) --------------
# HCS_REMOTE_LLM_ENABLED=false
# HCS_REMOTE_LLM_API_KEY=
